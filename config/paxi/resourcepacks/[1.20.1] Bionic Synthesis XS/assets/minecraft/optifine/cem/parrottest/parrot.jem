			"animations": [
				{
					"body.rx": "0",
					"rwing.visible": "ifb(is_on_ground, false, true)",
					"lwing.visible": "ifb(is_on_ground, false, true)",
					"lemur.rx": "if(is_on_ground, if(is_sitting, 0, torad(90)), torad(90))",
					"lemur.ty": "if(is_sitting, -6, 0)",
					"lemurhead.rx": "if(is_on_ground, if(is_sitting, head.rx, head.rx+torad(-90)), head.rx+torad(-90))",
					"lemurhead.ry": "head.rz",
					"lemurhead.rz": "head.ry",
					"right_ear.ry": "if(is_on_ground, 0, torad(180))",
					"left_ear.ry": "if(is_on_ground, 0, torad(180))",
					"right_ear.rx": "if(is_on_ground, 0, -sin(time*1.5)/70+torad(55))",
					"left_ear.rx": "if(is_on_ground, 0, -sin(time*1.5)/70+torad(55))",
					"right_ear.rz": "if(is_on_ground, torad(-7.5), torad(-10))",
					"left_ear.rz": "if(is_on_ground, torad(7.5), torad(10))",
					"rwing.ry": "sin(time*1.5)/70",
					"lwing.ry": "-sin(time*1.5)/70",
					"lemur_rightarm.rx": "if(is_on_ground, if(is_sitting, 0, torad(-90)), if((((sin((time+(random(id)*100))/10))*50)-40.45085)>0, (-sin(time))/3, 0))",
					"lemur_leftarm.rx": "if(is_on_ground, if(is_sitting, 0, torad(-90)), if((((sin((time+(random(id)*100))/10))*50)-40.45085)>0, (-sin(time))/3, 0))",
					"lemur_rightarm.tz": "if(is_on_ground, if(is_sitting, 0, -1), 0)",
					"lemur_leftarm.tz": "if(is_on_ground, if(is_sitting, 0, -1), 0)",
					"lemur_rightarm.tx": "if(is_on_ground, if(is_sitting, 0, 2), -3)",
					"lemur_leftarm.tx": "if(is_on_ground, if(is_sitting, 0, -2), 3)",
					"lemur_rightarm.ry": "if(is_on_ground, if(is_sitting, 0, if(limb_speed>0.5, sin(time/3)/3, 0)), 0)",
					"lemur_leftarm.ry": "if(is_on_ground, if(is_sitting, 0, if(limb_speed>0.5, sin(time/3)/3, 0)), 0)",
					"lemur_rightleg.rx": "if(is_on_ground, if(is_sitting && is_on_ground, torad(-40), if(limb_speed>0.5, -sin(time/3)/3+torad(-90), torad(-90))), 0)",
					"lemur_leftleg.rx": "if(is_on_ground, if(is_sitting && is_on_ground, torad(-40), if(limb_speed>0.5, sin(time/3)/3+torad(-90), torad(-90))), 0)",
					"lemur_rightleg.ty": "if(is_sitting && is_on_ground, 3, 5)",
					"lemur_leftleg.ty": "if(is_sitting && is_on_ground, 3, 5)",
					"lemur_rightleg.tx": "if(is_sitting && is_on_ground, -4, -2.5)",
					"lemur_leftleg.tx": "if(is_sitting && is_on_ground, 3, 1.5)",
					"lemur_rightleg.tz": "if(is_sitting && is_on_ground, 1, 0)",
					"lemur_leftleg.tz": "if(is_sitting && is_on_ground, 1, 0)",
					"lemur_rightleg.rz": "if(is_sitting && is_on_ground, torad(-30), 0)",
					"lemur_leftleg.rz": "if(is_sitting && is_on_ground, torad(30), 0)",
					"lemurtail1.rx": "if(is_on_ground, torad(-60), torad(-90))",
					"lemurtail2.rx": "if(is_on_ground, torad(30), torad(0))",
					"lemurtail3.rx": "if(is_on_ground, torad(-80), torad(0))",
					"lemurtail4.rx": "if(is_on_ground, torad(-110), torad(0))"
				}
