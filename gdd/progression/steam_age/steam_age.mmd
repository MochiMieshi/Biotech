    subgraph Copper
        copperRing[Copper ring]
        copperBolt[Copper bolt]
        copperCurvedPlate[Copper curved plate]
        copperRod[Copper rod]
        copperGear[Copper gear]
        copperRotor[Copper rotor]
    end

    lithicSlurry[Lithic slurry]

