        glassPane[Glass pane]
    end
end

subgraph Workstations
    furnace[Furnace]
end

subgraph Steam bucket
    steamBucket[Steam bucket]
end

smeltSteamBucket{Smelt}
furnace & waterBucket & fuels --> smeltSteamBucket --> steamBucket

subgraph Fire clay brick
    fireClayBrick[Fire clay brick]
end

smeltFireClayBrick{Smelt}
furnace & lithicSlurry & fuels --> smeltFireClayBrick --> fireClayBrick

subgraph Bronze boiler
    bronzeBoiler[Bronze boiler]
end

craftBronzeBoiler{Craft}
fireClayBrick & bronzePlate & furnace & bronzeTank --> craftBronzeBoiler --> bronzeBoiler

subgraph Fluid pipe
    fluidPipe[Fluid pipe]
end

